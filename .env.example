[TEMPLATE]
# VibeMusic environment configuration
# Copy to .env.local and adjust as needed.

# Path to a yt-dlp binary. If set, overrides the auto-bundled binary.
# If unset, the app uses the binary downloaded into vendor/ on postinstall.
#YTDLP_PATH=/usr/local/bin/yt-dlp

# Base URL for the LRCLIB lyrics API.
#LRCLIB_BASE_URL=https://lrclib.net/api

# Storage directory for extracted audio. Defaults to <project>/storage.
#STORAGE_DIR=/data/vibemusic/storage
# Whisper Tier 2 speech-to-text (zero-key). Comma-separated list of public
# Hugging Face Gradio space slugs to transcribe through (defaults to
# openai/whisper, hf-audio/whisper-large-v3, hf-audio/whisper-large-v3-turbo).
# Optional; if unset the built-in public spaces are used — no key required.
#AI_WHISPER_SPACES=openai/whisper,hf-audio/whisper-large-v3

# Optional keyed Tier 2 backends, tried BEFORE the zero-key Gradio race.
# Groq: OpenAI-compatible transcriptions (whisper-large-v3-turbo on LPU).
#AI_WHISPER_API_KEY=
#AI_WHISPER_ENDPOINT=https://api.groq.com/openai/v1/audio/transcriptions
#AI_WHISPER_MODEL=whisper-large-v3

# Puter: user-pays speech2txt (whisper-1) via @heyputer/puter.js. Requires
# Node >= 24 (the Dockerfile is staged on node:24). Free to developers.
#PUTER_AUTH_TOKEN=
#AI_PUTER_TOKEN=
